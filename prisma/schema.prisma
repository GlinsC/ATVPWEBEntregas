// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Model Motorista
model Motorista {
  id            Int       @id @default(autoincrement())
  nome          String
  cpf           String    @unique
  placaVeiculo  String
  status        String    @default("ATIVO")  // ATIVO, INATIVO, BLOQUEADO
  
  // Relação 1:N com Entrega
  entregas      Entrega[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Model Entrega
model Entrega {
  id            Int       @id @default(autoincrement())
  descricao     String
  origem        String
  destino       String
  status        String    @default("CRIADA")  // CRIADA, EM_TRANSITO, ENTREGUE, CANCELADA
  motoristaId   Int?
  
  // Relação N:1 com Motorista
  motorista     Motorista? @relation(fields: [motoristaId], references: [id])
  
  // Relação 1:N com EventoEntrega (com cascade delete)
  eventos       EventoEntrega[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Model EventoEntrega
model EventoEntrega {
  id            Int       @id @default(autoincrement())
  entregaId     Int
  data          DateTime  @default(now())
  descricao     String
  
  // Relação N:1 com Entrega
  entrega       Entrega   @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
