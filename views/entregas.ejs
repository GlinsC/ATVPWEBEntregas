<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel de Entregas</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="container">
    <header class="page-header">
      <div>
        <h1>Painel de Entregas</h1>
        <p class="subtitle">Filtre por status, crie entregas e veja o histórico de ações.</p>
      </div>
      <nav class="page-nav">
        <a href="/painel/entregas">Entregas</a>
        <a href="/painel/motorista">Motoristas</a>
        <a data-testid="btn-logout" class="button button-secondary" href="/logout">Sair</a>
      </nav>
    </header>

    <% if (errorMessage) { %>
      <div class="alert alert-error"><%= errorMessage %></div>
    <% } %>
    <% if (successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } %>

    <section class="panel-section form-section">
      <div class="form-card">
        <h2>Filtrar entregas</h2>
        <form method="GET" action="/painel/entregas" class="form-grid">
          <label>
            Status
            <select name="status">
              <option value="">Todos</option>
              <% statusOptions.forEach(option => { %>
                <option value="<%= option %>" <%= selectedStatus === option ? 'selected' : '' %>><%= option %></option>
              <% }) %>
            </select>
          </label>
          <button class="button" type="submit">Filtrar</button>
        </form>
      </div>

      <div class="form-card">
        <h2>Criar nova entrega</h2>
        <form method="POST" action="/painel/entregas" class="form-grid">
          <label>
            Descrição
            <input type="text" name="descricao" value="<%= formData.descricao || '' %>" required />
          </label>
          <label>
            Origem
            <input type="text" name="origem" value="<%= formData.origem || '' %>" required />
          </label>
          <label>
            Destino
            <input type="text" name="destino" value="<%= formData.destino || '' %>" required />
          </label>
          <button class="button button-primary" type="submit">Criar entrega</button>
        </form>
      </div>
    </section>

    <table data-testid="tabela-entregas">
      <thead>
        <tr>
          <th>ID</th>
          <th>Descrição</th>
          <th>Origem</th>
          <th>Destino</th>
          <th>Status</th>
          <th>Motorista</th>
          <th>Última Movimentação</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (entregas && entregas.length > 0) { %>
          <% entregas.forEach(entrega => { %>
            <tr>
              <td><%= entrega.id %></td>
              <td><%= entrega.descricao %></td>
              <td><%= entrega.origem %></td>
              <td><%= entrega.destino %></td>
              <td><%= entrega.status %></td>
              <td><%= entrega.motorista ? entrega.motorista.nome : "Sem motorista" %></td>
              <td>
                <% if (entrega.eventos && entrega.eventos.length > 0) { %>
                  <% const ultimoEvento = entrega.eventos[entrega.eventos.length - 1]; %>
                  <%= ultimoEvento.descricao %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td>
                <a class="button button-small" href="/painel/entregas/<%= entrega.id %>">Detalhes</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8">Nenhuma entrega encontrada.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
