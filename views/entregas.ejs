<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel de Entregas</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="container">
    <header class="page-header">
      <div>
        <h1>Painel de Entregas</h1>
        <p class="subtitle">Veja as entregas atuais organizadas em tabela.</p>
      </div>
      <nav class="page-nav">
        <a href="/painel/entregas">Entregas</a>
        <a href="/painel/motorista">Motoristas</a>
      </nav>
    </header>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Descrição</th>
          <th>Origem</th>
          <th>Destino</th>
          <th>Status</th>
          <th>Motorista</th>
          <th>Última Movimentação</th>
        </tr>
      </thead>
      <tbody>
        <% if (entregas && entregas.length > 0) { %>
          <% entregas.forEach(entrega => { %>
            <tr>
              <td><%= entrega.id %></td>
              <td><%= entrega.descricao %></td>
              <td><%= entrega.origem %></td>
              <td><%= entrega.destino %></td>
              <td><%= entrega.status %></td>
              <td><%= entrega.motorista ? entrega.motorista.nome : "Sem motorista" %></td>
              <td>
                <% if (entrega.eventos && entrega.eventos.length > 0) { %>
                  <% const ultimoEvento = entrega.eventos[entrega.eventos.length - 1]; %>
                  <%= ultimoEvento.descricao %>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7">Nenhuma entrega encontrada.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
