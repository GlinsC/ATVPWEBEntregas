<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Motorista <%= motorista.id %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="container">
    <header class="page-header">
      <div>
        <h1>Motorista #<%= motorista.id %></h1>
        <p class="subtitle">Detalhes do motorista e entregas atribuídas.</p>
      </div>
      <nav class="page-nav">
        <a href="/painel/entregas">Entregas</a>
        <a href="/painel/motorista">Motoristas</a>
      </nav>
    </header>

    <% if (errorMessage) { %>
      <div class="alert alert-error"><%= errorMessage %></div>
    <% } %>
    <% if (successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } %>

    <section class="panel-section">
      <h2>Informações do motorista</h2>
      <table>
        <tbody>
          <tr><th>ID</th><td><%= motorista.id %></td></tr>
          <tr><th>Nome</th><td><%= motorista.nome %></td></tr>
          <tr><th>CPF</th><td><%= motorista.cpf %></td></tr>
          <tr><th>Placa do Veículo</th><td><%= motorista.placaVeiculo %></td></tr>
          <tr><th>Status</th><td><%= motorista.status %></td></tr>
        </tbody>
      </table>
    </section>

    <section class="panel-section">
      <h2>Entregas atribuídas</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Descrição</th>
            <th>Origem</th>
            <th>Destino</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (entregas && entregas.length > 0) { %>
            <% entregas.forEach(entrega => { %>
              <tr>
                <td><%= entrega.id %></td>
                <td><%= entrega.descricao %></td>
                <td><%= entrega.origem %></td>
                <td><%= entrega.destino %></td>
                <td><%= entrega.status %></td>
                <td>
                  <a class="button button-small" href="/painel/entregas/<%= entrega.id %>">Ver entrega</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6">Nenhuma entrega atribuída.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>
  </div>
</body>
</html>
